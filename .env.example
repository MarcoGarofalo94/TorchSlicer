# TorchSlicer experiment configuration
# Copy this file to .env and edit as needed.
# Docker Compose reads .env automatically.
# All variables here can also be passed as shell exports or docker compose -e flags.
#
# Priority (highest wins): Python API kwargs > YAML config > env vars > defaults
# To use a YAML config file set EXPERIMENT_CONFIG below.

# ── YAML config (optional) ────────────────────────────────────────────────────
# When set, YAML values are used as base; individual env vars below override.
EXPERIMENT_CONFIG=
# Example: EXPERIMENT_CONFIG=experiments/resnet18_4gpu.yaml

# ── run identity ──────────────────────────────────────────────────────────────
# Auto-generated as a timestamp (YYYYMMDD_HHMMSS) if left empty.
RUN_ID=

# ── discovery ─────────────────────────────────────────────────────────────────
# backend: "coordinator" (workers self-register) | "static" (fixed peer list)
DISCOVERY_BACKEND=coordinator
N_WORKERS=2
# Seconds the coordinator waits for N_WORKERS registrations before timing out.
DISCOVERY_TIMEOUT=60
# Used when DISCOVERY_BACKEND=static. Comma-separated host:port list.
# WORKER_PEERS=worker1:50051,worker2:50051

# ── training ──────────────────────────────────────────────────────────────────
EPOCHS=10
MIXED_PRECISION=0

# ── pipeline parallelism (GPipe) ──────────────────────────────────────────────
USE_GPIPE=0
N_MICRO=4

# ── checkpointing (disabled by default) ───────────────────────────────────────
# Enable to save each worker's slice state at the end of training.
# Checkpoint files: {CHECKPOINT_DIR}/{RUN_ID}/worker_{i}_epoch_{n}.pt
#                   {CHECKPOINT_DIR}/{RUN_ID}/run_state.json
CHECKPOINT_ENABLED=0
CHECKPOINT_DIR=./checkpoints
# "epoch" = save after every epoch | "never" = only on shutdown
CHECKPOINT_SAVE_EVERY=epoch
# Path to run_state.json from a previous run to resume training.
CHECKPOINT_RESUME=
