version: 0.2.0
license: GPL-3.0-or-later
repository-code: "https://github.com/MarcoGarofalo94/TorchSlicer"
url: "https://github.com/MarcoGarofalo94/TorchSlicer"
keywords:
  - split learning
  - pytorch
  - distributed training
  - pipeline parallelism
