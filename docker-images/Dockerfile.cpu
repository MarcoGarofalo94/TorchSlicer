FROM ubuntu:22.04

# Update package index and upgrade existing packages
RUN apt update -y && \
    apt upgrade -y

# Install Python 3 and pip for package management
RUN apt install -y python3 python3-pip cargo

RUN apt install protobuf-compiler -y

RUN pip3 install fastapi
RUN pip3 install protobuf
RUN pip3 install grpcio grpcio-tools

# Upgrade numpy
RUN pip3 install --upgrade numpy

RUN mkdir /train
COPY ../examples/train/* /train/
COPY torchslicer/* /usr/local/bin/torchslicer/
RUN pip3 install /usr/local/bin/torchslicer/
COPY server.py /usr/local/bin/

WORKDIR /train


RUN chmod +x -R /usr/local/bin/torchslicer/* 

# Install PyTorch and its dependencies
RUN pip3 install torch --index-url https://download.pytorch.org/whl/cpu

# Set the default command to execute when the container starts
CMD ["python3","/train/server.py"]
