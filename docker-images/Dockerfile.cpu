FROM python:3.12-slim

# ── Layer 1: PyTorch (heavy — cached as long as this line doesn't change) ──────
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# ── Layer 2: runtime deps (invalidated independently of torch) ─────────────────
RUN pip install --no-cache-dir \
        grpcio==1.64.0 \
        grpcio-tools==1.64.0 \
        protobuf \
        pyyaml \
        fastapi==0.104.1 \
        "uvicorn[standard]==0.24.0" \
        requests==2.31.0 \
        pydantic==2.5.0 \
        opentelemetry-api>=1.24.0 \
        opentelemetry-sdk>=1.24.0 \
        opentelemetry-exporter-otlp-proto-grpc>=1.24.0 \
        peft>=0.10 \
        transformers>=4.40.0 \
        datasets>=2.18.0

# ── Layer 3: torchslicer library (invalidated when lib/ changes) ───────────────
COPY lib/torchslicer /usr/local/lib/torchslicer
RUN pip install --no-cache-dir -e /usr/local/lib/torchslicer

# ── Layer 4: compile proto files at build time ─────────────────────────────────
# The entrypoint also recompiles on startup, which is needed for dev (volume
# mount overwrites this layer). For production images with no volume mount,
# this layer is used directly — no startup overhead.
RUN python3 -m grpc_tools.protoc \
        -I /usr/local/lib/torchslicer \
        --python_out=/usr/local/lib/torchslicer \
        --grpc_python_out=/usr/local/lib/torchslicer \
        torchslicer/transport/grpc/coordinator/coordinator_service.proto \
        torchslicer/transport/grpc/worker/worker_service.proto

COPY docker-images/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
